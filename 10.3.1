-- Step 5: Query to retrieve student_id and name for students placed who also have sales (join with optimization)
SELECT p.student_id, p.name
FROM Placements p
JOIN Sales s ON p.student_id = s.student_id
-- Use optimizer hint or index if available for join efficiency
ORDER BY p.student_id;
