-- List all sales for students placed in TCS with selective columns
SELECT s.student_id, p.name, s.product, s.amount, TO_CHAR(s.sale_date, 'YYYY-MM-DD') AS sale_date
FROM Sales s
JOIN Placements p ON s.student_id = p.student_id
WHERE p.company = 'TCS'
ORDER BY s.sale_date;

-- Find student(s) placed in TCS with highest total sales
SELECT student_id, name, total_sales
FROM (
    SELECT p.student_id, p.name, SUM(s.amount) AS total_sales
    FROM Sales s
    JOIN Placements p ON s.student_id = p.student_id
    WHERE p.company = 'TCS'
    GROUP BY p.student_id, p.name
) totals
WHERE total_sales = (
    SELECT MAX(total_sales)
    FROM (
        SELECT SUM(s.amount) AS total_sales
        FROM Sales s
        JOIN Placements p ON s.student_id = p.student_id
        WHERE p.company = 'TCS'
        GROUP BY p.student_id
    )
);
