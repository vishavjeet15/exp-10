-- 1. Create the Placements table
CREATE TABLE Placements (
  student_id NUMBER PRIMARY KEY,
  name VARCHAR2(100),
  department VARCHAR2(50),
  company VARCHAR2(100),
  package NUMBER(5,2),
  placement_date DATE
);

